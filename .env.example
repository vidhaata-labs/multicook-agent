# =============================================================================
# Multicook Agent - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control (it is already in .gitignore).

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Choose the LLM provider. Options: google_genai, groq, openai
# Default: google_genai
LLM_PROVIDER=google_genai

# Model name for each provider (optional; defaults are used if omitted)
GOOGLE_MODEL=gemini-3.1-flash-lite
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# LLM Provider API Keys
# -----------------------------------------------------------------------------
# Google Gemini API key (used by langchain-google-genai).
# Get yours at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Groq API key (used by langchain-groq).
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key (used by langchain-openai).
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Search Tool API Keys
# -----------------------------------------------------------------------------
# Tavily API key (used by the web_search tool).
# Get yours at: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Set the logging level for the application.
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
MULTICOOK_LOG_LEVEL=INFO
